DB2I_HOST=
DB2I_PORT=50000
DB2I_DATABASE=
DB2I_USERNAME=
DB2I_PASSWORD=
DB2I_SCHEMA=
DB2I_ODBC_DRIVER="{IBM i Access ODBC Driver}"
DB2I_SSL=0
DB2I_OFFSET_COMPATIBILITY_MODE=false

# The test suite drops its own Abacus and fixture tables in DB2I_SCHEMA. Use a
# dedicated test schema and explicitly acknowledge that behavior here.
DB2I_ALLOW_DESTRUCTIVE_TESTS=false
